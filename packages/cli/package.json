{
  "name": "zstdify-cli",
  "version": "1.4.0",
  "description": "CLI for zstd compression and decompression using zstdify",
  "bugs": {
    "url": "https://github.com/bhouston/zstdify/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/zstdify.git",
    "directory": "packages/cli"
  },
  "bin": {
    "zstdify": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsgo",
    "tsgo": "tsgo",
    "dev": "tsgo --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "yargs": "^17.7.2",
    "yargs-file-commands": "^1.2.2",
    "zstdify": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/yargs": "^17.0.33"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
