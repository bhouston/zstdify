{
    "name": "zstdify-cli",
    "version": "1.3.1",
    "type": "module",
    "description": "CLI for zstd compression and decompression using zstdify",
    "license": "MIT",
    "main": "dist/index.js",
    "bin": {
        "zstdify": "dist/index.js"
    },
    "scripts": {
        "build": "tsgo",
        "tsgo": "tsgo",
        "dev": "tsgo --watch",
        "start": "node dist/index.js"
    },
    "dependencies": {
        "yargs": "^17.7.2",
        "yargs-file-commands": "^1.2.2",
        "zstdify": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^24",
        "@types/yargs": "^17.0.33"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bhouston/zstdify.git",
        "directory": "packages/cli"
    },
    "bugs": {
        "url": "https://github.com/bhouston/zstdify/issues"
    },
    "files": [
        "dist"
    ]
}