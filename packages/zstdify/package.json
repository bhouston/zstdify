{
    "name": "zstdify",
    "description": "Pure TypeScript zstd compression library",
    "version": "1.2.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./compress": {
            "types": "./dist/compress.d.ts",
            "import": "./dist/compress.js",
            "default": "./dist/compress.js"
        },
        "./decompress": {
            "types": "./dist/decompress.d.ts",
            "import": "./dist/decompress.js",
            "default": "./dist/decompress.js"
        },
        "./dictionary": {
            "types": "./dist/dictionary/generateDictionary.d.ts",
            "import": "./dist/dictionary/generateDictionary.js",
            "default": "./dist/dictionary/generateDictionary.js"
        },
        "./package.json": "./package.json"
    },
    "license": "MIT",
    "keywords": [
        "zstd",
        "compression",
        "decompression",
        "rfc8878"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bhouston/zstdify.git"
    },
    "bugs": {
        "url": "https://github.com/bhouston/zstdify/issues"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "scripts": {
        "build": "tsgo",
        "dev": "tsgo --watch",
        "tsgo": "tsgo",
        "test": "vitest"
    },
    "devDependencies": {
        "vitest": "^2.1.9"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "files": [
        "dist"
    ]
}