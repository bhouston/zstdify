{
    "name": "zstdify",
    "description": "Pure TypeScript zstd compression library",
    "version": "1.1.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "license": "MIT",
    "keywords": [
        "zstd",
        "compression",
        "decompression",
        "rfc8878"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bhouston/zstdify.git"
    },
    "bugs": {
        "url": "https://github.com/bhouston/zstdify/issues"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "scripts": {
        "build": "tsgo",
        "dev": "tsgo --watch",
        "tsgo": "tsgo",
        "test": "vitest"
    },
    "devDependencies": {
        "vitest": "^2.1.9"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "files": [
        "dist"
    ]
}