{
  "name": "zstdify-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest",
    "tsgo": "tsc --noEmit",
    "bench:prepare": "pnpm --filter zstdify run build",
    "debug:node-zstd-divergence": "pnpm run bench:prepare && node scripts/debug-node-zstd-divergence.ts",
    "bench:fetch-data": "node scripts/fetch-bench-data.ts",
    "bench:node-vs-zstdify": "pnpm run bench:prepare && node scripts/benchmark-node-vs-zstdify.ts",
    "bench:decode-only": "pnpm run bench:prepare && node scripts/benchmark-decode-only.ts",
    "bench:decode:assert": "node scripts/assert-decode-bench.ts",
    "bench:decode:gated": "pnpm run bench:decode-only && pnpm run bench:decode:assert",
    "bench:decode-profile": "pnpm run bench:prepare && node --cpu-prof --cpu-prof-name=zstdify-decode-profile.cpuprofile scripts/benchmark-decode-profile.ts",
    "bench:decode-profile:zstdify-node": "pnpm run bench:prepare && node --cpu-prof --cpu-prof-name=zstdify-decode-node-profile.cpuprofile scripts/benchmark-decode-profile-zstdify-node.ts",
    "bench:decode-profile:fzstd-node": "pnpm run bench:prepare && node --cpu-prof --cpu-prof-name=fzstd-decode-node-profile.cpuprofile scripts/benchmark-decode-profile-fzstd-node.ts",
    "bench:encode-profile": "pnpm run bench:prepare && node --cpu-prof --cpu-prof-name=zstdify-encode-profile.cpuprofile scripts/benchmark-encode-profile.ts",
    "bench:micro-hotpaths": "pnpm run bench:prepare && node scripts/benchmark-micro-hotpaths.ts",
    "bench:bundle-size": "pnpm run bench:prepare && node scripts/benchmark-bundle-size.ts",
    "bench:render": "node scripts/render-benchmark-chart.ts",
    "bench:update": "pnpm run bench:fetch-data && pnpm run bench:node-vs-zstdify && pnpm run bench:render",
    "bench:update:all": "pnpm run bench:update && pnpm run bench:bundle-size",
    "bench:phase0-baseline": "pnpm run bench:fetch-data && pnpm run bench:node-vs-zstdify && pnpm run bench:decode-only && pnpm run bench:decode:assert && pnpm run bench:decode-profile && pnpm run bench:render && pnpm run bench:micro-hotpaths"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^24",
    "fast-check": "^4.5.3",
    "fzstd": "^0.1.1",
    "rollup": "^4.58.0",
    "simple-zstd": "workspace:*",
    "tinybench": "^6.0.0",
    "typescript": "^5.6.0",
    "vega": "^5.30.0",
    "vega-lite": "^5.22.0",
    "vitest": "^4.0.0",
    "zstddec": "^0.2.0",
    "zstdify": "workspace:*"
  }
}
