{
  "name": "zstdify-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "clean": "rimraf dist packages/**/dist node_modules packages/**/node_modules",
    "check": "pnpm lint && pnpm format",
    "tsc": "tsgo -b",
    "tsgo": "pnpm -r tsgo",
    "test": "pnpm vitest",
    "coverage": "vitest run --coverage",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "make-release:zstdify": "node scripts/make-release.ts packages/zstdify",
    "make-release:cli": "node scripts/make-release.ts packages/cli"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@typescript/native-preview": "7.0.0-dev.20251229.1",
    "@vitest/coverage-v8": "^4.0.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "rimraf": "^6.0.1",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
